# Optional LIVE setup and original Participant Setup Guide smoke only.
# SAMPLE needs no environment file, account, credential or platform connection.
# Copy to .env.local for the application's explicit --zetaris-env-file argument.
# Set your own instance URL including /api/v1.0; do not use the web UI URL.
ZETARIS_REST_URL=
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Optional getting-started preflight/OpenAPI settings; never commit real values.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_USER_AGENT=

# Original guide smoke uses .env, not .env.local. These names are exact.
# The UI Runtime URL and route must also be passed explicitly as CLI flags.
# The Windows LIVE UI transport reads its token from the Runtime's private
# proxy-token file; it does not read MODEL_API_KEY from this template.
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=
NEMOTRON_MODEL=meterless/auto

# Optional original-guide web check only; not the SQL or AI endpoint.
# ZETARIS_BASE_URL=http://localhost:3000
